# ═══════════════════════════════════════════════════════════════
# Home Monitor - Variables de entorno
# Copia como .env y rellena los valores. NUNCA subas .env a Git.
# ═══════════════════════════════════════════════════════════════

# --- Entorno ---
APP_ENV=production
LOG_LEVEL=INFO
TZ=Europe/Madrid

# --- Seguridad (OBLIGATORIOS en producción) ---
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_PASSWORD=
ADMIN_USERNAME=admin
# Solo para desarrollo local sin auth. Con APP_ENV=production la app se niega
# a arrancar si está a true.
# ALLOW_INSECURE_NO_AUTH=true
# Marca Secure en la cookie de sesión. Déjalo en false si entras por HTTP en la
# LAN; ponlo a true si solo accedes por HTTPS.
SESSION_COOKIE_SECURE=false
# Nº de proxies de confianza delante de la app (nginx, Tailscale Funnel...).
# Necesario para que el rate limit de login vea la IP real del cliente.
# Déjalo en 0 si la app está expuesta directamente: activarlo sin proxy delante
# permite falsificar X-Forwarded-For.
TRUSTED_PROXIES=0

# --- Base de datos PostgreSQL (OBLIGATORIOS) ---
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# Tamaño máximo del pool de conexiones. Debe cubrir MAX_CHECK_WORKERS más los
# hilos que sirven HTTP. Por defecto: MAX_CHECK_WORKERS + 8.
# DB_POOL_MAX=28

# --- Monitorización ---
CHECK_INTERVAL_SECONDS=15
MAX_CHECK_WORKERS=20

# --- Home Assistant (opcionales, necesarios para monitores HA) ---
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Push Notifications VAPID (opcionales, necesarios para Web Push) ---
# Genera con: python -c "from pywebpush import webpush; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem()); print(v.public_key)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=

# --- Docker metrics (true por defecto, false si no montas el socket) ---
DOCKER_METRICS_ENABLED=true

# --- Status page (pública, SIN autenticación) ---
# Expone nombres de dispositivos, latencias e incidencias a cualquiera que
# alcance el puerto. Déjala en false salvo que quieras publicarla de verdad.
STATUS_PAGE_ENABLED=false

# --- NAS URL (para seed de dispositivo NAS) ---
NAS_URL=https://nas.local:5001
