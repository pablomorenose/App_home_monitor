[Unit]
Description=Home Monitor Dashboard (Flask backend)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/home-monitor
ExecStart=/home/pi/home-monitor/venv/bin/gunicorn --workers 1 --threads 8 \
    --bind 0.0.0.0:8088 --access-logfile - --timeout 60 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
